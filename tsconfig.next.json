// Used only by `next dev` / `next build` for the API route handlers during the Vite transition
// (next.config.ts `typescript.tsconfigPath`), so Next's automatic tsconfig edits stay out of tsconfig.json.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "dist", "target", "scripts/ops/admin-season3-diff/run-ts.ts", ".cache"]
}
