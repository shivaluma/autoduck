generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  avatarUrl   String?
  scars       Int       @default(0)
  shields     Int       @default(0)
  shieldsUsed Int       @default(0) // Tổng số khiên đã dùng
  totalKhaos  Int       @default(0) // Tổng số lần làm dzịt
  cleanStreak Int       @default(0)
  isBoss      Boolean   @default(false)
  bossSince   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  raceParticipations RaceParticipant[]
  ownedShields       Shield[]          @relation("ShieldOwner")
  loanedShieldsOut   Shield[]          @relation("ShieldLoanedTo")
  mysteryChests      MysteryChest[]
  dragonOrbs         DragonOrb[]       @relation("DragonOrbCurrentOwner")
  originalDragonOrbs DragonOrb[]       @relation("DragonOrbOriginalOwner")
  dragonTradesMade   DragonTrade[]     @relation("DragonTradeProposer")
  dragonTradesTarget DragonTrade[]     @relation("DragonTradeCounterparty")
  dragonTradesTaken  DragonTrade[]     @relation("DragonTradeAcceptedBy")
  dragonSummons      DragonSummon[]
  dragonItems        DragonItem[]
  dragonOrbEvents    DragonOrbEvent[]
  dragonItemEvents   DragonItemEvent[]
}

model Race {
  id           Int       @id @default(autoincrement())
  status       String    @default("pending") // pending, running, finished, failed
  videoUrl     String?
  finalVerdict String? // Câu chốt "Ai là con dzịt"
  createdAt    DateTime  @default(now())
  finishedAt   DateTime?
  isTest       Boolean   @default(false)

  participants   RaceParticipant[]
  commentaries   CommentaryLog[]
  commentaryJobs CommentaryJob[]
  dragonWeeks    DragonWeek[]
  dragonOrbs     DragonOrb[]     @relation("DragonOrbOriginalRace")
  dragonItems    DragonItem[]    @relation("DragonItemEquippedRace")
  dragonOrbEvents  DragonOrbEvent[]
  dragonItemEvents DragonItemEvent[]

  @@index([createdAt])
  @@index([isTest, createdAt])
  @@index([status, isTest, finishedAt, id])
}

model RaceParticipant {
  id                   Int     @id @default(autoincrement())
  raceId               Int
  userId               Int
  usedShield           Boolean @default(false)
  shieldId             Int?
  shieldChargesAtStart Int?
  shieldBackfired      Boolean @default(false)
  initialRank          Int? // Thứ hạng gốc AI đọc được
  gotScar              Boolean @default(false) // Kết quả cuối: có bị sẹo không?
  isClone              Boolean @default(false)
  cloneOfUserId        Int?
  cloneIndex           Int?
  displayName          String?
  chestEffect          String?
  chestTargetUserId    Int?
  dragonEligible       Boolean @default(true)

  race Race @relation(fields: [raceId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([raceId, userId, cloneIndex])
  @@index([userId])
}

model Shield {
  id           Int       @id @default(autoincrement())
  ownerId      Int
  earnedAt     DateTime  @default(now())
  earnedRaceId Int?
  charges      Int       @default(5)
  weeksUnused  Int       @default(0)
  status       String    @default("active")
  consumedAt   DateTime?
  loanedToId   Int?

  owner    User  @relation("ShieldOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  loanedTo User? @relation("ShieldLoanedTo", fields: [loanedToId], references: [id])

  @@index([ownerId, status])
}

model MysteryChest {
  id               Int       @id @default(autoincrement())
  ownerId          Int
  earnedFromRaceId Int
  status           String    @default("active")
  effect           String
  rngSeed          String
  consumedRaceId   Int?
  consumedAt       DateTime?
  targetUserId     Int?
  createdAt        DateTime  @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, status])
  @@index([earnedFromRaceId])
  @@index([earnedFromRaceId, effect])
}

model WeeklyTick {
  id            Int      @id @default(autoincrement())
  weekKey       String   @unique
  runAt         DateTime @default(now())
  brokenShields Int      @default(0)
  lostShields   Int      @default(0)
  newBosses     Int      @default(0)
  chestsIssued  Int      @default(0)
  details       String?
}

model AppMigration {
  id    String   @id
  name  String
  runAt DateTime @default(now())
}

model CommentaryLog {
  id        Int    @id @default(autoincrement())
  raceId    Int
  timestamp Int // Giây thứ bao nhiêu trong video
  content   String // Nội dung AI bình luận

  race Race @relation(fields: [raceId], references: [id], onDelete: Cascade)

  @@index([raceId, timestamp])
}

// Job queue for async commentary generation
model CommentaryJob {
  id               Int       @id @default(autoincrement())
  raceId           Int
  timestamp        Int // Giây thứ bao nhiêu trong cuộc đua
  screenshotB64    String // Base64 encoded screenshot (JPEG)
  isRaceEnd        Boolean   @default(false)
  participantNames String? // Comma-separated duck names for AI prompt
  raceResults      String? // JSON race results for end-of-race commentary
  status           String    @default("pending") // pending, processing, completed, failed
  result           String? // Generated commentary
  error            String?
  createdAt        DateTime  @default(now())
  processedAt      DateTime?

  race Race @relation(fields: [raceId], references: [id], onDelete: Cascade)

  @@index([raceId, status])
  @@index([status, createdAt])
}

model DragonWeek {
  id            Int      @id @default(autoincrement())
  seasonKey     String   @default("default")
  weekKey       String
  weekStart     DateTime
  weekEnd       DateTime
  star          Int
  raceId        Int?
  awardedOrbId  Int?
  status        String   @default("SCHEDULED")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  race Race? @relation(fields: [raceId], references: [id], onDelete: SetNull)
  orbs DragonOrb[] @relation("DragonWeekOrbs")

  @@unique([seasonKey, weekKey])
  @@index([star])
  @@index([raceId])
}

model DragonOrb {
  id               Int      @id @default(autoincrement())
  currentOwnerId   Int
  originalOwnerId  Int?
  originalRaceId   Int?
  dragonWeekId     Int?
  seasonKey        String   @default("default")
  star             Int
  status           String   @default("ACTIVE")
  source           String   @default("RACE_WIN")
  lockedByTradeId  Int?
  lockedBySummonId Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  consumedAt       DateTime?
  voidedAt         DateTime?

  currentOwner User @relation("DragonOrbCurrentOwner", fields: [currentOwnerId], references: [id], onDelete: Cascade)
  originalOwner User? @relation("DragonOrbOriginalOwner", fields: [originalOwnerId], references: [id], onDelete: SetNull)
  originalRace Race? @relation("DragonOrbOriginalRace", fields: [originalRaceId], references: [id], onDelete: SetNull)
  dragonWeek DragonWeek? @relation("DragonWeekOrbs", fields: [dragonWeekId], references: [id], onDelete: SetNull)
  offeredTrades DragonTrade[] @relation("DragonTradeOfferedOrb")
  acceptedTrades DragonTrade[] @relation("DragonTradeAcceptedOrb")
  orbEvents DragonOrbEvent[]

  @@unique([originalRaceId, source])
  @@index([currentOwnerId, status])
  @@index([currentOwnerId, seasonKey, status])
  @@index([originalRaceId])
  @@index([dragonWeekId])
  @@index([star])
  @@index([lockedByTradeId])
  @@index([lockedBySummonId])
}

model DragonOrbEvent {
  id          Int      @id @default(autoincrement())
  orbId       Int?
  userId      Int?
  raceId      Int?
  tradeId     Int?
  summonId    Int?
  type        String
  message     String?
  payloadJson String?
  createdAt   DateTime @default(now())

  orb DragonOrb? @relation(fields: [orbId], references: [id], onDelete: SetNull)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  race Race? @relation(fields: [raceId], references: [id], onDelete: SetNull)
  trade DragonTrade? @relation(fields: [tradeId], references: [id], onDelete: SetNull)
  summon DragonSummon? @relation(fields: [summonId], references: [id], onDelete: SetNull)

  @@index([orbId])
  @@index([userId, createdAt])
  @@index([raceId])
  @@index([tradeId])
  @@index([summonId])
  @@index([type, createdAt])
}

model DragonTrade {
  id             Int      @id @default(autoincrement())
  proposerId     Int
  counterpartyId Int?
  offeredOrbId   Int
  requestedStar  Int
  acceptedById   Int?
  acceptedOrbId  Int?
  status         String   @default("PENDING")
  message        String?
  expiresAt      DateTime?
  createdAt      DateTime @default(now())
  acceptedAt     DateTime?
  cancelledAt    DateTime?
  voidedAt       DateTime?
  updatedAt      DateTime @updatedAt

  proposer User @relation("DragonTradeProposer", fields: [proposerId], references: [id], onDelete: Cascade)
  counterparty User? @relation("DragonTradeCounterparty", fields: [counterpartyId], references: [id], onDelete: SetNull)
  acceptedBy User? @relation("DragonTradeAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  offeredOrb DragonOrb @relation("DragonTradeOfferedOrb", fields: [offeredOrbId], references: [id], onDelete: Cascade)
  acceptedOrb DragonOrb? @relation("DragonTradeAcceptedOrb", fields: [acceptedOrbId], references: [id], onDelete: SetNull)
  orbEvents DragonOrbEvent[]

  @@index([proposerId, status])
  @@index([counterpartyId, status])
  @@index([requestedStar, status])
  @@index([offeredOrbId])
  @@index([acceptedOrbId])
  @@index([status, createdAt])
}

model DragonSummon {
  id                 Int      @id @default(autoincrement())
  userId             Int
  seasonKey          String   @default("default")
  status             String   @default("PENDING")
  consumedOrbIdsJson String?
  createdAt          DateTime @default(now())
  resolvedAt         DateTime?
  blockedReason      String?
  grantedItemId      Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  orbEvents DragonOrbEvent[]
  items DragonItem[]

  @@index([userId, status])
  @@index([status])
  @@index([grantedItemId])
}

model DragonItem {
  id                Int      @id @default(autoincrement())
  userId            Int
  summonId          Int?
  type              String   @default("DRAGON_SCALE")
  status            String   @default("ACTIVE")
  source            String   @default("DRAGON_SUMMON")
  label             String   @default("Long Lân Hộ Mệnh")
  subtitle          String   @default("Vảy Rồng")
  payloadJson       String?
  equippedForRaceId Int?
  grantedAt         DateTime @default(now())
  equippedAt        DateTime?
  consumedAt        DateTime?
  voidedAt          DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  summon DragonSummon? @relation(fields: [summonId], references: [id], onDelete: SetNull)
  equippedForRace Race? @relation("DragonItemEquippedRace", fields: [equippedForRaceId], references: [id], onDelete: SetNull)
  events DragonItemEvent[]

  @@index([userId, status])
  @@index([type, status])
  @@index([equippedForRaceId])
}

model DragonItemEvent {
  id          Int      @id @default(autoincrement())
  itemId      Int
  userId      Int
  raceId      Int?
  type        String
  message     String?
  payloadJson String?
  createdAt   DateTime @default(now())

  item DragonItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  race Race? @relation(fields: [raceId], references: [id], onDelete: SetNull)

  @@index([itemId])
  @@index([userId, createdAt])
  @@index([raceId])
  @@index([type, createdAt])
}
