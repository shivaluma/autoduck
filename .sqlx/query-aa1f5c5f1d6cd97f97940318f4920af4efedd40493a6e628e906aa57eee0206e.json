  "query": "SELECT \"id\" AS \"id!: i64\", \"status\" AS \"status!\", \"engineState\" AS \"engineState!\", \"engineVersion\"\n           FROM \"Race\"\n           WHERE \"status\" IN ('pending', 'running')\n             AND NOT COALESCE(CAST(substr(\"engineVersion\", 1, instr(\"engineVersion\", '.') - 1) AS INT) >= 2, 0)\n           ORDER BY \"id\"",
