  "query": "SELECT \"id\" AS \"id!: i64\", \"engineState\" AS \"engineState!\", \"isTest\" AS \"isTest!: bool\"\n           FROM \"Race\"\n           WHERE \"status\" IN ('pending', 'running')\n             AND CAST(substr(\"engineVersion\", 1, instr(\"engineVersion\", '.') - 1) AS INT) >= 2\n           ORDER BY \"id\"",
