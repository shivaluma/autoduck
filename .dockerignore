# Build context for ./Dockerfile (Rust server + Vite SPA). Keep it small: no build output,
# no dependencies, no databases, no secrets.
.git
node_modules
**/node_modules
.next
target
dist
.cache
tmp
.playwright-mcp
crates/race-wasm/pkg
prisma/generated
prisma/backups
backups
**/*.db
**/*.db-journal
**/*.db-wal
**/*.db-shm
.env*
.DS_Store
*.tsbuildinfo
.pnpm-build-approvals.json
docs
# Only the replay-track manifest is read at runtime (boot step 10); balance outputs are docs.
artifacts/*
!artifacts/replay-tracks
artifacts/replay-tracks/*
!artifacts/replay-tracks/manifest.json
