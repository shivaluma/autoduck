{
  "name": "autoduck",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "env AUTODUCK_ENV=dev SQLX_OFFLINE=true cargo run -p autoduck-server --bin autoduck -- serve",
    "build": "bash scripts/build-wasm.sh --require-bindgen && pnpm build:web",
    "build:web": "tsc --noEmit -p tsconfig.json && vite build",
    "build:wasm": "bash scripts/build-wasm.sh --require-bindgen",
    "check:bundle": "node scripts/check-client-bundle.mjs",
    "preview": "vite preview",
    "lint": "eslint",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "cosmetics:generate": "tsx scripts/generate-cosmetics.ts",
    "cosmetics:previews": "tsx scripts/generate-cosmetics.ts",
    "cosmetics:validate": "tsx scripts/validate-cosmetics.ts",
    "cosmetics:export-catalog": "tsx scripts/cosmetics/export-catalog.ts",
    "gacha:simulate": "tsx scripts/gacha-simulate.ts",
    "economy:simulate": "tsx scripts/economy-simulate.ts",
    "race:fx": "tsx scripts/generate-race-fx.ts",
    "codegen:engine": "cargo run -q -p race-cli -- codegen --out src/engine/generated"
  },
  "dependencies": {
    "@fontsource-variable/baloo-2": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "@fontsource-variable/quicksand": "5.3.0",
    "@fontsource/be-vietnam-pro": "5.3.0",
    "clsx": "^2.1.1",
    "phaser": "4.2.1",
    "radix-ui": "^1.4.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-router": "7.18.4",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@tailwindcss/vite": "4.2.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "playwright": "^1.59.1",
    "shadcn": "^4.3.1",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5"
  }
}
